#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
plugin_dir="$repository_root/plugins/billy-plugin"

api_mcp_version=$(tr -d '[:space:]' < "$repository_root/API_MCP_VERSION")
api_mcp_commit=$(tr -d '[:space:]' < "$repository_root/API_MCP_COMMIT")
if ! printf '%s\n' "$api_mcp_version" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$'; then
  echo "API_MCP_VERSION must contain a v-prefixed semantic version tag" >&2
  exit 1
fi
if ! printf '%s\n' "$api_mcp_commit" | grep -Eq '^[0-9a-f]{40}$'; then
  echo "API_MCP_COMMIT must contain exactly one full lowercase Git commit hash" >&2
  exit 1
fi

python3 - "$repository_root" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
marketplace_path = root / ".agents/plugins/marketplace.json"
manifest_path = root / "plugins/billy-plugin/.codex-plugin/plugin.json"
mcp_path = root / "plugins/billy-plugin/.mcp.json"
config_path = root / "plugins/billy-plugin/config/billy.json"
features_path = root / "plugins/billy-plugin/config/features.json"
notices_path = root / "plugins/billy-plugin/THIRD_PARTY_NOTICES.md"
api_mcp_version = (root / "API_MCP_VERSION").read_text().strip()
api_mcp_commit = (root / "API_MCP_COMMIT").read_text().strip()

documents = {}
for path in (marketplace_path, manifest_path, mcp_path, config_path, features_path):
    documents[path] = json.loads(path.read_text())

marketplace = documents[marketplace_path]
manifest = documents[manifest_path]
mcp = documents[mcp_path]
config = documents[config_path]
features = documents[features_path]

assert marketplace["name"] == "billy"
assert marketplace["plugins"][0]["name"] == manifest["name"] == "billy-plugin"
assert marketplace["plugins"][0]["source"]["path"] == "./plugins/billy-plugin"
assert manifest["license"] == "MIT"
assert manifest["mcpServers"] == "./.mcp.json"
assert manifest["skills"] == "./skills/"
assert "billy-plugin" in mcp["mcpServers"]
assert config["toolPolicy"]["defaultFeatures"] == ["read-only"]
assert config["auth"]["keychain"]["promptOnMissing"] is True
assert "read-only" in {feature["id"] for feature in features["features"]}
assert next(feature for feature in features["features"] if feature["id"] == "read-only")["endpoints"] == ["GET *"]
notices = notices_path.read_text()
assert api_mcp_version in notices
assert api_mcp_commit in notices

for relative in (
    "LICENSE",
    "README.md",
    "README.da.md",
    "THIRD_PARTY_NOTICES.md",
    "bin/darwin-arm64/billy-mcp",
    "config/billy.json",
    "config/features.json",
    "openapi/billy.yaml",
    "openapi/README.da.md",
    "skills/accounting/SKILL.md",
):
    assert (root / "plugins/billy-plugin" / relative).is_file(), relative

for relative in (
    "README.da.md",
    "PRIVACY.da.md",
    "SECURITY.da.md",
    "SUPPORT.da.md",
    "CONTRIBUTING.da.md",
    "docs/RELEASING.da.md",
):
    assert (root / relative).is_file(), relative

english_plugin_guide = (root / "plugins/billy-plugin/README.md").read_text()
danish_plugin_guide = (root / "plugins/billy-plugin/README.da.md").read_text()
for guide in (english_plugin_guide, danish_plugin_guide):
    assert "billy-mcp" in guide
    assert "com.morphar.billy-plugin" in guide
    assert "-25293" in guide

print("plugin structure: ok")
PY

for script in "$repository_root"/scripts/* "$plugin_dir"/scripts/* "$plugin_dir"/*.command; do
  [ -f "$script" ] || continue
  sh -n "$script"
done

(
  cd "$plugin_dir"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 -c SHA256SUMS
  else
    sha256sum -c SHA256SUMS
  fi
)

echo "release package: ok"
